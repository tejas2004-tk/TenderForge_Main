MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=tenderforge
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CONNECTION_TIMEOUT_MS=90000
GEMINI_CONNECTION_RETRY_ATTEMPTS=3
GEMINI_CONNECTION_RETRY_BASE_SECONDS=1
GEMINI_CONNECTION_RETRY_MAX_SECONDS=30
FRONTEND_ORIGIN=http://localhost:5173
PORT=5000
FLASK_DEBUG=true
COOKIE_SECURE=false
MAX_TENDER_SIZE_MB=25
ANALYSIS_MAX_INPUT_TOKENS=6000
ANALYSIS_MAX_OUTPUT_TOKENS=4000
ANALYSIS_MAX_TPM_TOKENS=8000
ANALYSIS_REQUEST_INTERVAL_SECONDS=2
ANALYSIS_RETRY_ATTEMPTS=3
ANALYSIS_RETRY_BASE_SECONDS=2
ANALYSIS_LEASE_SECONDS=300
ANALYSIS_VERSION=6
ANALYSIS_PROMPT_VERSION=5
