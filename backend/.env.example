MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=tenderforge
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
ANALYSIS_PROVIDER_ORDER=groq,openrouter,gemini
GROQ_API_KEY=your_groq_api_key_here
# Required when Groq is enabled in ANALYSIS_PROVIDER_ORDER; choose your deployed model.
GROQ_MODEL=
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=TenderForge
ANALYSIS_PROVIDER_TIMEOUT_SECONDS=30
ANALYSIS_PROVIDER_CONNECT_TIMEOUT_SECONDS=10
GEMINI_CONNECTION_TIMEOUT_MS=90000
GEMINI_CONNECTION_RETRY_ATTEMPTS=3
GEMINI_CONNECTION_RETRY_BASE_SECONDS=1
GEMINI_CONNECTION_RETRY_MAX_SECONDS=30
FRONTEND_ORIGIN=http://localhost:5173
PORT=5000
FLASK_DEBUG=true
COOKIE_SECURE=false
MAX_TENDER_SIZE_MB=25
ANALYSIS_MAX_INPUT_TOKENS=6000
ANALYSIS_MAX_OUTPUT_TOKENS=4000
ANALYSIS_MAX_TPM_TOKENS=8000
ANALYSIS_BATCH_TARGET_OUTPUT_TOKENS=1600
ANALYSIS_MIN_SEGMENT_CHARS=120
ANALYSIS_MAX_SPLIT_DEPTH=2
ANALYSIS_REQUEST_INTERVAL_SECONDS=2
ANALYSIS_RETRY_ATTEMPTS=3
ANALYSIS_RETRY_BASE_SECONDS=2
ANALYSIS_PROVIDER_MAX_COOLDOWN_SECONDS=300
ANALYSIS_LEASE_SECONDS=300
ANALYSIS_VERSION=6
ANALYSIS_PROMPT_VERSION=5
